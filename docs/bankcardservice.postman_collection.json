{
  "info": {
    "name": "Bank Card Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API collection for Bank Card Service.\n\nVariables:\n- {{baseUrl}}     — http://localhost:8080\n- {{token}}       — Auth0 M2M access token (client_credentials) → ROLE_ADMIN\n- {{userToken}}   — Auth0 user access token (password grant, user@example.com) → ROLE_USER\n- {{adminId}}     — seeded admin user id (1)\n- {{userId}}      — seeded test user id (2)\n- {{card1Id}}     — seeded VISA card id (1)\n- {{card2Id}}     — seeded Mastercard card id (2)\n- {{txId}}        — seeded transaction id (1)\n\nSeed data (fresh DB):\n  User1: admin@example.com  id=1  ROLE_ADMIN\n  User2: user@example.com   id=2  ROLE_USER\n  Card1: **** **** **** 1111  VISA DEBIT   balance=5000  id=1  owner=user@example.com\n  Card2: **** **** **** 5559  MC   CREDIT  balance=0     id=2  owner=user@example.com\n  Tx1/Tx2: DEBIT/CREDIT 500 USD on those cards"
  },
  "variable": [
    {"key": "baseUrl",    "value": "http://localhost:8080"},
    {"key": "token",      "value": "<your_m2m_admin_token>"},
    {"key": "userToken",  "value": "<your_user_token>"},
    {"key": "adminId",    "value": "1"},
    {"key": "userId",     "value": "2"},
    {"key": "card1Id",    "value": "1"},
    {"key": "card2Id",    "value": "2"},
    {"key": "txId",       "value": "1"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/swagger-ui/index.html", "host": ["{{baseUrl}}"], "path": ["swagger-ui","index.html"]}
          }
        },
        {
          "name": "OpenAPI JSON spec",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/v3/api-docs", "host": ["{{baseUrl}}"], "path": ["v3","api-docs"]}
          }
        }
      ]
    },
    {
      "name": "Users (ADMIN)",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/v1/users/{{adminId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{adminId}}"]}
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/search?query=admin&page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users","search"],
              "query": [{"key":"query","value":"admin"},{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Get users by role",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/role/ADMIN?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users","role","ADMIN"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"securePassword123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api","v1","users"]}
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin Updated\",\n  \"email\": \"admin@example.com\",\n  \"phoneNumber\": \"+0000000000\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/users/{{adminId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{adminId}}"]}
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/v1/users/{{adminId}}/activate", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{adminId}}","activate"]}
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/v1/users/{{adminId}}/deactivate", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{adminId}}","deactivate"]}
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/v1/users/{{adminId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{adminId}}"]}
          }
        }
      ]
    },
    {
      "name": "Cards (ADMIN)",
      "item": [
        {
          "name": "Get all cards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","cards"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Get card by ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/v1/cards/{{card1Id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","{{card1Id}}"]}
          }
        },
        {
          "name": "Search cards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards/search?query=1111&page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","cards","search"],
              "query": [{"key":"query","value":"1111"},{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Create card",
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"4111111111111113\",\n  \"cardHolderName\": \"Test User\",\n  \"expirationDate\": \"2030-12\",\n  \"cardBrand\": \"VISA\",\n  \"cardType\": \"DEBIT\",\n  \"balance\": 1000.00,\n  \"cardStatus\": \"ACTIVE\",\n  \"currency\": \"USD\",\n  \"userId\": {{userId}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/cards", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"]}
          }
        },
        {
          "name": "Update card",
          "request": {
            "method": "PUT",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{card1Id}},\n  \"expirationDate\": \"2031-06\",\n  \"cardStatus\": \"ACTIVE\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/cards/{{card1Id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","{{card1Id}}"]}
          }
        },
        {
          "name": "Block card",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/v1/cards/{{card1Id}}/block", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","{{card1Id}}","block"]}
          }
        },
        {
          "name": "Activate card",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/v1/cards/{{card1Id}}/activate", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","{{card1Id}}","activate"]}
          }
        },
        {
          "name": "Delete card",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/v1/cards/{{card1Id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","{{card1Id}}"]}
          }
        }
      ]
    },
    {
      "name": "My Cards (USER)",
      "item": [
        {
          "name": "Get my cards",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{userToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","cards"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Search my cards",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{userToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/search?query=1111&page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","cards","search"],
              "query": [{"key":"query","value":"1111"},{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        },
        {
          "name": "Get card balance",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{userToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}/balance", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","cards","{{card1Id}}","balance"]}
          }
        },
        {
          "name": "Transfer balance",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Authorization","value":"Bearer {{userToken}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}/transfers?targetCardId={{card2Id}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","cards","{{card1Id}}","transfers"],
              "query": [{"key":"targetCardId","value":"{{card2Id}}"}]
            }
          }
        },
        {
          "name": "Request card block",
          "request": {
            "method": "PATCH",
            "header": [{"key":"Authorization","value":"Bearer {{userToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","cards","{{card1Id}}"]}
          }
        }
      ]
    },
    {
      "name": "Transactions (ADMIN)",
      "item": [
        {
          "name": "Get transaction by ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/v1/transactions/{{txId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","transactions","{{txId}}"]}
          }
        },
        {
          "name": "Get transactions by card ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/card/{{card1Id}}?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","transactions","card","{{card1Id}}"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        }
      ]
    },
    {
      "name": "My Transactions (USER)",
      "item": [
        {
          "name": "Get my transactions",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{userToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/me?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["api","v1","transactions","me"],
              "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}]
            }
          }
        }
      ]
    }
  ]
}