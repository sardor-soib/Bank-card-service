              ]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Search my cards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/search?query=1111&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me", "cards", "search"],
              "query": [
                { "key": "query", "value": "1111" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Get card balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/1/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me", "cards", "1", "balance"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Transfer balance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "500.00"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/1/transfers?targetCardId=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me", "cards", "1", "transfers"],
              "query": [{ "key": "targetCardId", "value": "2" }]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Request card block",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/1",
