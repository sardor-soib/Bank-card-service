              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"maskedPan\": \"**** **** **** 1111\",\n  \"cardHolderName\": \"JOHN DOE\",\n  \"expirationDate\": \"2031-06\",\n  \"balance\": 1500.00,\n  \"cardStatus\": \"ACTIVE\",\n  \"userId\": 1\n}"
            },
            "url": {
