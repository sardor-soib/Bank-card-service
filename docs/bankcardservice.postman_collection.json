{
  "info": {
    "name": "Bank Card Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for Bank Card Service.\n\nSetup:\n1. Set {{baseUrl}} to your server (default: http://localhost:8080)\n2. Get an Auth0 access token from your tenant and set {{token}}\n3. For M2M (admin) testing use a client_credentials token where sub ends with @clients\n\nNOTE: /api-docs.yaml requires token (bug — should be public). Use /v3/api-docs instead."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "<your_auth0_access_token>" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/swagger-ui/index.html",
              "host": ["{{baseUrl}}"],
              "path": ["swagger-ui", "index.html"]
            }
          },
          "_live": { "status": 200 }
        },
        {
          "name": "OpenAPI JSON spec",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["v3", "api-docs"]
            }
          },
          "_live": { "status": 200 }
        },
        {
          "name": "OpenAPI YAML spec [BUG: returns 401]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api-docs.yaml",
              "host": ["{{baseUrl}}"],
              "path": ["api-docs.yaml"]
            }
          },
          "_live": { "status": 401, "note": "/api-docs.yaml not in permitAll — needs fix in SecurityConfig" }
        }
      ]
    },
    {
      "name": "Users (ADMIN)",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "_live": { "status": 401, "note": "Requires valid Auth0 JWT" }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "1"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/search?query=john&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [
                { "key": "query", "value": "john" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Get users by role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/role/USER?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "role", "USER"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"securePassword123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Updated\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"newPassword123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "1"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/1/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "1", "activate"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/1/deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "1", "deactivate"]
            }
          },
          "_live": { "status": 401 }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "1"]
            }
          },
          "_live": { "status": 401 }
        }
      ]
    },
