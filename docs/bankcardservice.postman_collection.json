        {
          "name": "Delete card",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cards", "1"]
            }
          },
          "_live": { "status": 401 }
        }
      ]
    },
    {
      "name": "My Cards (USER)",
      "item": [
        {
          "name": "Get my cards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
