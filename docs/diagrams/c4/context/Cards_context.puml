@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Debet Cards System - Context

Person(customer, "Customer", "Пользователь пользуется картами")
Person(admin, "Admin", "Пользователь управляет всеми картами и пользователями")

System(debetCardsSystem, "Debet Cards System", "Управления картами")
System(transactionsSystem, "TransactionsSystem", "Упраления переводами")
System(usersSystem, "Users System", "Управления пользователями")


Rel(customer, debetCardsSystem, "Смотрит свои карты/баланс, запрашивает блок/разблок. карты", "HTTPS")
Rel(customer, transactionsSystem, "Делает переводы между своими картами", "HTTPS")
Rel(admin, debetCardsSystem, "Управляет всеми картами(CRUD) + блок/разблок карты, ", "HTTPS")
Rel(admin, usersSystem, "Управляет всеми пользователями(CRUD)", "HTTPS")

@enduml