{
  "info": {
    "name": "Bank Card Service — User",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "ROLE_USER endpoints.\n\nVariables to set:\n  {{userToken}} — Auth0 user access token (password grant)\n  {{baseUrl}}   — http://localhost:8080  (already set)\n\nSeeded IDs (fresh DB):\n  card1Id=1  card2Id=2"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userToken",
      "value": "<your_user_token>"
    },
    {
      "key": "card1Id",
      "value": "1"
    },
    {
      "key": "card2Id",
      "value": "2"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/swagger-ui/index.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger-ui",
                "index.html"
              ]
            }
          }
        },
        {
          "name": "OpenAPI spec",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "My Cards",
      "item": [
        {
          "name": "Get my cards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "cards"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search my cards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/search?query=1111&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "cards",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "1111"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get card balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "cards",
                "{{card1Id}}",
                "balance"
              ]
            }
          }
        },
        {
          "name": "Transfer balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}/transfers?targetCardId={{card2Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "cards",
                "{{card1Id}}",
                "transfers"
              ],
              "query": [
                {
                  "key": "targetCardId",
                  "value": "{{card2Id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Request card block",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/cards/{{card1Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "cards",
                "{{card1Id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "My Transactions",
      "item": [
        {
          "name": "Get my transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/me?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "me"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}