# Application
SERVER_PORT=replace-with-your-app-port

# PostgreSQL
POSTGRES_DB=replace-with-your-db-name
POSTGRES_USER=replace-with-your-db-user
POSTGRES_PASSWORD=replace-with-your-db-password
POSTGRES_HOST=replace-with-your-db-host
POSTGRES_PORT=replace-with-your-db-port

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:
SPRING_DATASOURCE_USERNAME=db-user // example:postgres
SPRING_DATASOURCE_PASSWORD=db-password // example:5432

# Bank card security
# Generate a real value with: openssl rand -base64 32
BANK_CARDS_PAN_HASH_SECRET=replace-this-with-a-long-random-secret

# Auth0 — https://manage.auth0.com/dashboard
# Domain example: your-tenant.eu.auth0.com
AUTH0_DOMAIN=replace-with-your-auth0-domain
AUTH0_AUDIENCE=https://your-api-identifier  # e.g. https://bank-card-service